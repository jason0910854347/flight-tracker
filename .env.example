# ═══════════════════════════════════════════════════════════
# Flight Fare Monitor — Environment Configuration
# ═══════════════════════════════════════════════════════════

# ── 通用設定 ────────────────────────────────────────────
TIMEZONE_OFFSET=8
TIMEZONE_LABEL=UTC+8 Asia/Taipei
LOG_RETENTION_DAYS=30
LOG_FILE_LEVEL=DEBUG

# ── 排程 (python app.py --loop) ────────────────────────
# 檢查間隔 (分鐘，最小 5)
CHECK_INTERVAL_MINUTES=60
# 隨機抖動 (± 分鐘)，避免每次固定整點請求
CHECK_JITTER_MINUTES=5

# ── 資料 ────────────────────────────────────────────────
# 上一輪資料 data/latest.json；變動紀錄 data/history/YYYYMMDD.jsonl
DATA_DIR=data
HISTORY_RETENTION_DAYS=90

# ═══════════════════════════════════════════════════════════
# 行程
# ═══════════════════════════════════════════════════════════
# 類型：單程 / 來回
TRIP_TYPE=來回
# 出發地點 (IATA 代號)
ORIGIN=TPE
# 目的地 / 回程地點 (IATA 代號) — 胡志明市 新山一國際機場
DESTINATION=SGN
# 去程日期 yyyymmdd
DEPART_DATE=20261112
# 回程日期 yyyymmdd (單程可留空)
RETURN_DATE=20261116
# 去程起飛時間 (選填，空白 = 不限)：HH:MM-HH:MM 時段，或 HH:MM 指定班次
DEPART_TIME=
# 回程起飛時間 (選填，空白 = 不限)
RETURN_TIME=
# 成人人數
ADULTS=1
# 艙等：經濟艙 / 豪華經濟艙 / 商務艙 / 頭等艙
CABIN=經濟艙
# 幣別
CURRENCY=TWD
# 最多轉機次數 (0 = 只看直飛)
MAX_STOPS=0

# ═══════════════════════════════════════════════════════════
# 航空公司 (逗號分隔 IATA 代號)
# ═══════════════════════════════════════════════════════════
AIRLINES=JX,CI

# ── 星宇航空 ────────────────────────────────────────────
JX_ENABLED=true
JX_NAME=星宇航空
# starlux = 官網 API (含稅 / 未稅 / 稅金皆有)
JX_SOURCE=starlux
JX_COLOR=#8C6D46
# 卡片「前往官網訂票」按鈕連結
JX_BOOKING_URL=https://www.starlux-airlines.com/zh-TW/booking/book-flight/search-a-flight

# ── 中華航空 ────────────────────────────────────────────
CI_ENABLED=true
CI_NAME=中華航空
# google_flights = Google Flights (僅含稅總價；華航官網有 Imperva 防爬，無法自動化)
CI_SOURCE=google_flights
CI_COLOR=#C8102E
# 卡片「前往官網訂票」按鈕連結 (價格來自 Google Flights，另附「Google Flights 比價」按鈕)
CI_BOOKING_URL=https://booking.china-airlines.com/booking/Index?country=tw&locale=zh
# 華航官網票價頁 → 卡片顯示「官網參考價」(同日期最低價，非即時、不分航班；空白 = 不查)
# 任一華航航線票價頁皆可 (只用來讀取票價服務設定，實際查詢依 ORIGIN / DESTINATION / 日期)
CI_REFERENCE_PAGE=https://flights.china-airlines.com/zh-tw/flights-from-taipei-to-ho-chi-minh-city

# ── 瀏覽器 (Playwright) ─────────────────────────────────
BROWSER_HEADLESS=true
# chrome = 使用本機 Google Chrome；空白 = Playwright 內建 Chromium
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT_SEC=60
# 單一航空失敗重試次數
SCRAPER_RETRY=2

# ═══════════════════════════════════════════════════════════
# 通知規則
# ═══════════════════════════════════════════════════════════
# 價差門檻：兩者皆須達到才推送 (金額為絕對值；百分比 0 = 不限)
NOTIFY_MIN_CHANGE_AMOUNT=1
NOTIFY_MIN_CHANGE_PERCENT=0
# 首次執行 (或行程條件變更) 推送「目前最低價」摘要卡
NOTIFY_ON_FIRST_RUN=true
# 新增班次 / 班次售完下架 也推送
NOTIFY_AVAILABILITY_CHANGES=true
# 資料來源抓取失敗時推送警示卡
NOTIFY_ON_ERROR=true
# 每輪最多推送幾張價格卡
NOTIFY_MAX_CARDS=10

# ── Webhook (Post API — Adaptive Card) ─────────────────
WEBHOOK_ENABLED=true
WEBHOOK_URL=
# teams = {"type":"message","attachments":[Adaptive Card]} (Teams Workflows / Incoming Webhook)
# raw   = 直接 POST Adaptive Card JSON (自建 API)
WEBHOOK_FORMAT=teams
WEBHOOK_TIMEOUT_SEC=30
WEBHOOK_VERIFY_SSL=true

# ── LINE Messaging API (Flex Message) ──────────────────
# LINE Notify 已於 2025-03-31 停止服務，改用 Messaging API
# LINE Developers Console → Messaging API channel → Channel access token (long-lived)
LINE_ENABLED=true
LINE_CHANNEL_ACCESS_TOKEN=
# Basic settings → Channel secret (選填；tools/line_group_id.py 用來驗證 Webhook 簽章)
LINE_CHANNEL_SECRET=
# 推送對象 userId / groupId (U.../C...)；空白 = broadcast 給所有加好友的人
# 取得群組 ID：python tools/line_group_id.py --tunnel --write-env
LINE_TO=
LINE_TIMEOUT_SEC=30
